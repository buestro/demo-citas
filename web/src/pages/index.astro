---
import Layout from "../layouts/Layout.astro";
import { site, whatsappUrl, formatMoney, hoursSummary, durationText } from "../lib";

const b = site.business;
const hours = hoursSummary();
const minPrice = Math.min(...site.services.map((s) => s.price_from));
---
<Layout
  title={`${b.name} · ${b.tagline}`}
  description={`${b.name}: ${b.tagline}. Agenda tu cita en línea, consulta servicios, precios y horarios.`}
>
  <main>
    <section class="hero">
      <div class="container">
        <h1>{b.tagline}</h1>
        <p class="lead">Atención puntual, precios claros y cita en línea, sin esperar a que te contesten por WhatsApp.</p>
        <ul class="facts">
          <li>{hours[0].label}: {hours[0].text}</li>
          <li>{b.location.area}, {b.location.city}</li>
          <li>Valoración desde {formatMoney(minPrice)}</li>
        </ul>
        <div class="actions">
          <a class="btn" href="#agendar">Agendar cita</a>
          <a class="btn btn-soft" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="section" id="servicios">
      <div class="container">
        <h2>Servicios</h2>
        <p class="small">Precios desde, por pieza o tratamiento. El precio final se confirma en la valoración.</p>
        <div class="grid">
          {site.services.map((s) => (
            <article class="card">
              <h3>{s.name}</h3>
              <p>{s.description}</p>
              <div class="meta">
                <span class="price">Desde {formatMoney(s.price_from)}</span>
                <span>{durationText(s.duration_minutes)}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft" id="agendar">
      <div class="container">
        <h2>Agendar cita</h2>
        <div class="book-box">
          <h3>Aquí irá la agenda en línea</h3>
          <p>Elegirás el servicio, el día y la hora, y dejarás solo tu nombre y teléfono. Se conecta en el siguiente paquete del proyecto.</p>
          <p class="small">No pedimos motivo de consulta ni datos de salud. Si el paciente es menor, agenda el adulto con su propio nombre y teléfono.</p>
        </div>
      </div>
    </section>

    <section class="section" id="horario">
      <div class="container two-col">
        <div>
          <h2>Horario</h2>
          <table class="hours">
            <tbody>
              {hours.map((h) => (<tr><th scope="row">{h.label}</th><td>{h.text}</td></tr>))}
            </tbody>
          </table>
        </div>
        <div>
          <h2>Ubicación</h2>
          <p>{b.location.area}, {b.location.city}</p>
          <p>Estacionamiento: {b.parking}.</p>
          <p>Pagos: {b.payment_methods.join(", ")}.</p>
          <a class="btn btn-soft" href={b.location.maps_url} target="_blank" rel="noopener">Cómo llegar</a>
        </div>
      </div>
    </section>

    <section class="section section-soft" id="doctora">
      <div class="container doctor">
        <div class="avatar" aria-hidden="true">{b.professional.initials}</div>
        <div>
          <h2>{b.professional.name}</h2>
          <p class="small">{b.professional.title} · Cédula profesional: {b.professional.license}</p>
          <p>{b.professional.bio}</p>
        </div>
      </div>
    </section>

    <section class="section" id="preguntas">
      <div class="container" style="max-width:44rem">
        <h2>Preguntas frecuentes</h2>
        {site.faq.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </section>
  </main>

  <nav class="sticky-bar" aria-label="Acciones rápidas">
    <a class="btn" href="#agendar">Agendar cita</a>
    <a class="btn btn-soft" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
  </nav>
</Layout>
