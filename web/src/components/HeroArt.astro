---
// Decorative hero illustration: a friendly tooth with floating "product" chips around it.
// Pure inline SVG + CSS (colors come from the theme tokens), no images and no JS.
---
<div class="hero-art" aria-hidden="true">
  <svg viewBox="0 0 400 400" class="art-svg" focusable="false">
    <circle cx="200" cy="205" r="170" fill="var(--brand-soft)" />
    <circle cx="200" cy="205" r="124" fill="none" stroke="var(--brand)" stroke-opacity="0.18" stroke-width="2" stroke-dasharray="4 10" class="ring" />

    <g class="tooth">
      <ellipse cx="200" cy="352" rx="82" ry="10" fill="var(--brand-ink)" opacity="0.12" class="shadow" />
      <g transform="translate(70 62) scale(10.8)">
        <path d="M7 3c-2 0-4 1.5-4 4.5 0 2 1 3 1.5 5.5.4 2 .5 8 2.5 8 1.8 0 1.5-5 3-5s1.2 5 3 5c2 0 2.100-6 2.500-8 .5-2.500 1.500-3.500 1.500-5.500C20 4.500 18 3 16 3c-1.500 0-2.200.8-4 .8S8.500 3 7 3z"
          fill="#fff" stroke="var(--brand-ink)" stroke-width="0.55" stroke-linejoin="round" />
        <path d="M6.300 5.200c.8-.9 1.900-1 2.700-.7" fill="none" stroke="var(--brand)" stroke-opacity="0.35" stroke-width="0.6" stroke-linecap="round" />
      </g>
      <g class="face">
        <ellipse cx="166" cy="170" rx="7" ry="9" fill="var(--brand-ink)" class="eye" />
        <ellipse cx="234" cy="170" rx="7" ry="9" fill="var(--brand-ink)" class="eye" />
        <circle cx="146" cy="196" r="9" fill="var(--accent)" opacity="0.45" />
        <circle cx="254" cy="196" r="9" fill="var(--accent)" opacity="0.45" />
        <path d="M178 192q22 24 44 0" fill="none" stroke="var(--brand-ink)" stroke-width="5" stroke-linecap="round" />
      </g>
    </g>

    <g class="spark s1"><path d="M70 110l5 14 14 5-14 5-5 14-5-14-14-5 14-5z" fill="var(--accent)" /></g>
    <g class="spark s2"><path d="M332 86l4 11 11 4-11 4-4 11-4-11-11-4 11-4z" fill="var(--brand)" /></g>
    <g class="spark s3"><path d="M338 262l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" fill="var(--accent)" /></g>
    <circle cx="96" cy="300" r="7" fill="var(--brand)" opacity="0.5" class="bubble b1" />
    <circle cx="318" cy="184" r="5" fill="var(--accent)" opacity="0.7" class="bubble b2" />
  </svg>

  <div class="chip-float c1"><span class="dot"></span>Cita confirmada · 17:00</div>
  <div class="chip-float c2"><svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.600 7.100L4 20l1-4.600A8 8 0 1 1 21 12z" /></svg>Recordatorio enviado</div>
</div>
