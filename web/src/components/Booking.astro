---
// Booking form: service -> day -> time -> name and phone. Talks to the FastAPI service.
// Vanilla JS, no dependencies. It asks only for name and phone (never a reason for the visit).
import { site, formatMoney, durationText } from "../lib";

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000";
const services = site.services.map((s) => ({ id: s.id, name: s.name, price: formatMoney(s.price_from), duration: durationText(s.duration_minutes) }));
const openDays = site.hours.map((h) => h.ranges.length > 0); // Monday..Sunday
---
<div class="booking" id="booking" data-api={apiUrl} data-open-days={JSON.stringify(openDays)} data-horizon="14">
  <form class="book-form" novalidate>
    <fieldset class="book-step">
      <legend><span class="step-n">1</span> Servicio</legend>
      <div class="pill-row">
        {services.map((s, i) => (
          <label class="pill">
            <input type="radio" name="service" value={s.id} checked={i === 0} />
            <span>{s.name}<small>{s.duration} · desde {s.price}</small></span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="book-step">
      <legend><span class="step-n">2</span> Día</legend>
      <div class="pill-row days" id="days" role="radiogroup" aria-label="Día de la cita"></div>
    </fieldset>

    <fieldset class="book-step">
      <legend><span class="step-n">3</span> Hora</legend>
      <div class="slot-grid" id="slots" aria-live="polite"><p class="small">Elige un día para ver los horarios.</p></div>
    </fieldset>

    <fieldset class="book-step">
      <legend><span class="step-n">4</span> Tus datos</legend>
      <div class="fields">
        <label class="field">Nombre
          <input name="name" autocomplete="name" required minlength="2" maxlength="60" placeholder="Ana Pérez" />
        </label>
        <label class="field">Teléfono (10 dígitos)
          <input name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="33 1234 5678" />
        </label>
        <label class="hp" aria-hidden="true">No llenar<input name="website" tabindex="-1" autocomplete="off" /></label>
      </div>
      <p class="small">Es una demo: usa un nombre y teléfono de ejemplo. No escribas datos de salud ni de menores. <a href="/privacidad">Aviso de privacidad</a>.</p>
    </fieldset>

    <p class="form-error" id="book-error" role="alert" hidden></p>
    <button class="btn" type="submit" id="book-submit" disabled>Confirmar cita</button>
  </form>

  <div class="confirm" id="confirm" hidden tabindex="-1">
    <div class="confirm-icon" aria-hidden="true">✓</div>
    <h3 id="confirm-title">¡Listo!</h3>
    <p id="confirm-text"></p>
    <p class="small">En un consultorio real, un día antes llegaría un recordatorio por WhatsApp.</p>
    <div class="actions">
      <button class="btn btn-soft" type="button" id="cancel-appt">Cancelar esta cita</button>
      <button class="btn btn-soft" type="button" id="book-another">Agendar otra</button>
    </div>
  </div>
</div>

<script>
  const root = document.getElementById("booking") as HTMLElement;
  const api = (root.dataset.api ?? "").replace(/\/$/, "");
  const openDays: boolean[] = JSON.parse(root.dataset.openDays ?? "[]");
  const horizon = Number(root.dataset.horizon ?? 14);
  const form = root.querySelector<HTMLFormElement>(".book-form")!;
  const daysEl = document.getElementById("days")!;
  const slotsEl = document.getElementById("slots")!;
  const errorEl = document.getElementById("book-error")!;
  const submit = document.getElementById("book-submit") as HTMLButtonElement;
  const confirmEl = document.getElementById("confirm")!;
  let day = "";
  let time = "";
  let last: { id: string; token: string } | null = null;

  const tz = "America/Mexico_City";
  const todayStr = new Intl.DateTimeFormat("en-CA", { timeZone: tz }).format(new Date()); // YYYY-MM-DD
  const base = new Date(todayStr + "T12:00:00Z");
  const label = (iso: string, opts: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat("es-MX", { timeZone: "UTC", ...opts }).format(new Date(iso + "T12:00:00Z"));

  const setNote = (text: string) => {
    const p = document.createElement("p");
    p.className = "small"; p.textContent = text;
    slotsEl.replaceChildren(p);
  };
  const showError = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = !msg; };
  const service = () => (form.querySelector<HTMLInputElement>("input[name=service]:checked")!).value;
  const refreshSubmit = () => {
    const f = new FormData(form);
    submit.disabled = !(day && time && String(f.get("name")).trim().length >= 2 && String(f.get("phone")).replace(/\D/g, "").length >= 10);
  };

  // A radio "pill" built with DOM nodes and textContent: nothing from the network is ever parsed as HTML.
  function pill(cls: string, name: string, value: string, content: (string | Node)[]) {
    const l = document.createElement("label");
    l.className = cls;
    const i = document.createElement("input");
    i.type = "radio"; i.name = name; i.value = value;
    const s = document.createElement("span");
    s.append(...content);
    l.append(i, s);
    return l;
  }

  // Day chips: the next `horizon` days that the office opens.
  for (let i = 0; i <= horizon; i++) {
    const d = new Date(base.getTime() + i * 86400000);
    const iso = d.toISOString().slice(0, 10);
    const weekdayMonFirst = (d.getUTCDay() + 6) % 7;
    if (!openDays[weekdayMonFirst]) continue;
    const strong = document.createElement("strong");
    strong.textContent = label(iso, { day: "numeric" });
    const small = document.createElement("small");
    small.textContent = label(iso, { month: "short" });
    daysEl.appendChild(pill("pill pill-day", "day", iso, [label(iso, { weekday: "short" }), strong, small]));
  }

  async function loadSlots() {
    time = ""; refreshSubmit(); showError("");
    if (!day) return;
    setNote("Buscando horarios…");
    try {
      const r = await fetch(`${api}/api/availability?service_id=${service()}&date=${day}`);
      if (!r.ok) throw new Error();
      const { slots } = await r.json();
      if (!slots.length) { setNote("No quedan horarios ese día. Prueba otro."); return; }
      slotsEl.replaceChildren();
      for (const s of slots as string[]) {
        if (!/^\d{2}:\d{2}$/.test(s)) continue; // only HH:MM ever reaches the page
        slotsEl.appendChild(pill("pill pill-time", "time", s, [s]));
      }
    } catch {
      setNote("No pudimos cargar los horarios. Si la demo estaba dormida, espera unos segundos y elige el día otra vez.");
    }
  }

  form.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "service") loadSlots();
    if (t.name === "day") { day = t.value; loadSlots(); }
    if (t.name === "time") { time = t.value; }
    refreshSubmit();
  });
  form.addEventListener("input", refreshSubmit);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    showError("");
    submit.disabled = true; submit.textContent = "Confirmando…";
    const f = new FormData(form);
    try {
      const r = await fetch(`${api}/api/appointments`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ service_id: service(), date: day, time, name: f.get("name"), phone: f.get("phone"), website: f.get("website") }),
      });
      const data = await r.json();
      if (!r.ok) {
        const d = data.detail;
        showError(Array.isArray(d) ? (d[0]?.msg ?? "Revisa tus datos.").replace(/^Value error, /, "") : (d ?? "No pudimos agendar. Intenta de nuevo."));
        if (r.status === 409 || r.status === 422) loadSlots();
        return;
      }
      last = { id: data.id, token: data.token };
      const when = label(data.start.slice(0, 10), { weekday: "long", day: "numeric", month: "long" });
      document.getElementById("confirm-title")!.textContent = `¡Listo, ${String(data.name).split(" ")[0]}!`;
      document.getElementById("confirm-text")!.textContent = `${data.service.name}: ${when} a las ${data.start.slice(11)}.`;
      form.hidden = true; confirmEl.hidden = false; confirmEl.focus();
    } catch {
      showError("No pudimos conectar con la agenda. Intenta de nuevo en unos segundos.");
    } finally {
      submit.textContent = "Confirmar cita"; refreshSubmit();
    }
  });

  document.getElementById("cancel-appt")!.addEventListener("click", async () => {
    if (!last) return;
    const r = await fetch(`${api}/api/appointments/${last.id}/cancel`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token: last.token }) });
    document.getElementById("confirm-title")!.textContent = r.ok ? "Cita cancelada" : "No pudimos cancelar";
    document.getElementById("confirm-text")!.textContent = r.ok ? "El horario quedó libre otra vez." : "Intenta de nuevo.";
    if (r.ok) last = null;
  });
  document.getElementById("book-another")!.addEventListener("click", () => {
    confirmEl.hidden = true; form.hidden = false; time = ""; last = null; loadSlots();
  });
</script>
